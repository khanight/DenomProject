# Telegram Bot (required)
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs allowed to use this bot (mandatory auth gate).
# Find your ID via @userinfobot or similar.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Local Ollama router (Qwen)
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_HOST=http://localhost:11434

# Strict sandbox for all Claude CLI executions.
# Relative paths resolve from the project root. Created automatically if missing.
SANDBOX_DIR=./sandbox

# Auth note: Claude CLI uses a local Claude Pro OAuth session (not an API key).
# Do NOT set ANTHROPIC_API_KEY in this process or the host environment — the
# executor strips it from the subprocess env so --chrome keeps working.
